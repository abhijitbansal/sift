<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abhijitbansal.sift</string>

  <!-- Reads the secrets from the login keychain at run time; they never live in
       this file, the config, or the repo. SIFT_SMTP_PASSWORD is optional (email
       is opt-in); a missing item just leaves it empty and email is skipped.

       After a successful run, the new digest under docs/ is committed and pushed
       so GitHub Pages updates. For that to publish, the repo must be checked out
       on the branch Pages serves (main), the working tree clean, and push
       credentials available to launchd (an SSH key added with
       `ssh-add --apple-use-keychain`, or a git credential helper). If nothing
       new was found, `sift run` writes no digest, the staged diff is empty, and
       nothing is committed. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export ANTHROPIC_API_KEY="$(security find-generic-password -s ANTHROPIC_API_KEY -w)"; export SIFT_SMTP_PASSWORD="$(security find-generic-password -s SIFT_SMTP_PASSWORD -w 2>/dev/null)"; cd "$HOME/projects/sift" &amp;&amp; uv run sift run &amp;&amp; git add -A docs &amp;&amp; { git diff --cached --quiet || { git commit -m "chore(digest): publish $(date -u +%G-%V)" &amp;&amp; git push; }; }</string>
  </array>

  <!-- Sunday 06:00 in the machine's local timezone (Mac mini is on ET).
       launchd has no per-job timezone; adjust Hour if the machine moves. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/com.abhijitbansal.sift.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.abhijitbansal.sift.err.log</string>
</dict>
</plist>
