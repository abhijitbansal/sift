{
  "name": "Sift",
  "short_name": "Sift",
  "description": "A weekly AI-news digest, curated for one reader.",
  "theme_color": "#ff4f8b",
  "background_color": "#130a1e",
  "display": "minimal-ui",
  "icons": [
    {
      "src": "assets/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any"
    },
    {
      "src": "assets/favicon-32.png",
      "type": "image/png",
      "sizes": "32x32"
    },
    {
      "src": "assets/favicon-16.png",
      "type": "image/png",
      "sizes": "16x16"
    },
    {
      "src": "assets/apple-touch-icon.png",
      "type": "image/png",
      "sizes": "180x180"
    }
  ]
}
